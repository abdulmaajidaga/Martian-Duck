  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Hazeltop + Bearwallow
  shortName: Hazeltop + Bearwallow
  category: Sample site
  when: "Sols 509 & 516  \xB7  Jul 27 & Aug 3, 2022"
  activity: Drilled two rock cores, Hazeltop and Bearwallow, from the Wildcat Ridge outcrop and sealed them in sample tubes. The material is sedimentary rock.
  subtitle: "Rock Core  \xB7  Sedimentary"
  details: "Samples 12 & 13  \xB7  Wildcat Ridge outcrop, Fan Front\nSol 509 & 516  \xB7  Jul. 27&Aug. 3, 2022  \xB7  sample length 3.1 cm"
  photos:
  - image: {fileID: 2800000, guid: afd8819487efb5541be348ea0b2629a4, type: 3}
    caption: The robotic arm at the outcrop
    credit: "Front Hazcam  \xB7  Sol 509  \xB7  NASA/JPL-Caltech"
  - image: {fileID: 2800000, guid: ef036429b3d5e7c46805e4ccb9fd353b, type: 3}
    caption: The abrasion patch, rock ground flat for analysis
    credit: "WATSON  \xB7  Sol 504  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 06d470c66e479b14f8186e5405337bfd, type: 3}
    caption: The outcrop with an abrasion patch and drill hole
    credit: "Navcam  \xB7  Sol 509  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.40588851
  latitude: 18.45863707
  revealRadius: 15
