  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Depot tube 9
  shortName: Tube 9
  category: Depot tube
  when: "Sol 682  \xB7  Jan 20, 2023"
  activity: Perseverance set sample tube 9 of 10 down here while building the Three Forks depot, a backup set of samples for a future Mars Sample Return mission.
  subtitle: Sample tube left at the Three Forks depot
  details: "Dropped on sol 682 (9 of 10)  \xB7  photographed sol 682 (2023-01-20)\nPosition: where the rover parked to drop it (about 1-2 m)"
  photos:
  - image: {fileID: 2800000, guid: 04f855499706cd54fad8620f6068e146, type: 3}
    caption: The tube on the ground under the rover, just after the drop
    credit: "WATSON  \xB7  Sol 682  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 577eb55320d13744ead93460669265f6, type: 3}
    caption: The tube on the ground after the rover backed away
    credit: "Front Hazcam  \xB7  Sol 684  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.408601
  latitude: 18.453066
  revealRadius: 4
