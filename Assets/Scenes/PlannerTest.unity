  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Shuyak + Mageik
  shortName: Shuyak + Mageik
  category: Sample site
  when: "Sols 575 & 579  \xB7  Oct 2 & 6, 2022"
  activity: Drilled two rock cores, Shuyak and Mageik, from the Amalik outcrop and sealed them in sample tubes. The material is sedimentary rock.
  subtitle: "Rock Core  \xB7  Sedimentary"
  details: "Samples 14 & 15  \xB7  Amalik outcrop, Fan Front\nSol 575 & 579  \xB7  Oct. 2&6, 2022  \xB7  sample length 6.5 cm"
  photos:
  - image: {fileID: 2800000, guid: d71c0b1f4c06ec04c81e28f305031468, type: 3}
    caption: The robotic arm at the outcrop
    credit: "Front Hazcam  \xB7  Sol 575  \xB7  NASA/JPL-Caltech"
  - image: {fileID: 2800000, guid: b546cad5d01fb534492db1d2eb16d7f9, type: 3}
    caption: The abrasion patch, rock ground flat for analysis
    credit: "WATSON  \xB7  Sol 568  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 0bed42b8cf3590a4a965d54232587c99, type: 3}
    caption: The outcrop with drill holes
    credit: "Navcam  \xB7  Sol 575  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.40144029
  latitude: 18.45072631
  revealRadius: 15
