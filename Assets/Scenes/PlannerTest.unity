  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Kukaklek
  shortName: Kukaklek
  category: Sample site
  when: "Sol 631  \xB7  Nov 29, 2022"
  activity: Drilled one rock core, Kukaklek, from the Hidden Harbor outcrop and sealed it in a sample tube. The material is sedimentary rock.
  subtitle: "Rock Core  \xB7  Sedimentary"
  details: "Sample 16  \xB7  Hidden Harbor outcrop, Fan Front\nSol 631  \xB7  Nov. 29, 2022  \xB7  sample length 6.0 cm"
  photos:
  - image: {fileID: 2800000, guid: db294700a03f144459991a1d1a1881da, type: 3}
    caption: Looking out from the sampling site
    credit: "Front Hazcam  \xB7  Sol 626  \xB7  NASA/JPL-Caltech"
  - image: {fileID: 2800000, guid: fe10e3a8d11137e449978ce0c8955366, type: 3}
    caption: The abrasion patch, rock ground flat for analysis
    credit: "WATSON  \xB7  Sol 612  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: c4b9ad6a261073749babc2551fcec611, type: 3}
    caption: The outcrop with an abrasion patch
    credit: "Front Hazcam  \xB7  Sol 626  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.39911421
  latitude: 18.45363597
  revealRadius: 15
