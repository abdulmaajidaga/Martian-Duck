  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Depot tube 4
  shortName: Tube 4
  category: Depot tube
  when: "Sol 666  \xB7  Jan 4, 2023"
  activity: Perseverance set sample tube 4 of 10 down here while building the Three Forks depot, a backup set of samples for a future Mars Sample Return mission.
  subtitle: Sample tube left at the Three Forks depot
  details: "Dropped on sol 666 (4 of 10)  \xB7  photographed sol 666 (2023-01-04)\nPosition: where the rover parked to drop it (about 1-2 m)"
  photos:
  - image: {fileID: 2800000, guid: 961df367bc564394486a746062b2430c, type: 3}
    caption: The tube on the ground under the rover, just after the drop
    credit: "WATSON  \xB7  Sol 666  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 17860fbba43352748ba704a4fda302c5, type: 3}
    caption: The tube on the ground after the rover backed away
    credit: "Front Hazcam  \xB7  Sol 667  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.408078
  latitude: 18.452766
  revealRadius: 4
