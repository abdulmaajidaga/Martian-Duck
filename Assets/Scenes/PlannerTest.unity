  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Swift Run + Skyland
  shortName: Swift Run + Skyland
  category: Sample site
  when: "Sols 490 & 495  \xB7  Jul 7 & 12, 2022"
  activity: Drilled two rock cores, Swift Run and Skyland, from the Skinner Ridge outcrop and sealed them in sample tubes. The material is sedimentary rock.
  subtitle: "Rock Core  \xB7  Sedimentary"
  details: "Samples 10 & 11  \xB7  Skinner Ridge outcrop, Fan Front\nSol 490 & 495  \xB7  Jul. 7&12, 2022  \xB7  sample length 6.1 cm"
  photos:
  - image: {fileID: 2800000, guid: 4a80799ef59348e41819e4a11bfa767a, type: 3}
    caption: The robotic arm at the outcrop
    credit: "Front Hazcam  \xB7  Sol 490  \xB7  NASA/JPL-Caltech"
  - image: {fileID: 2800000, guid: f62145dffe8aade41aa834b8cae70510, type: 3}
    caption: The abrasion patch, rock ground flat for analysis
    credit: "WATSON  \xB7  Sol 482  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 13c25f67e6dc7bd4f9d9677fa96db30a, type: 3}
    caption: Layered rock and wind ripples at the site
    credit: "Navcam  \xB7  Sol 490  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.40617493
  latitude: 18.45893136
  revealRadius: 15
