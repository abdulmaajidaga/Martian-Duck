  m_Script: {fileID: 11500000, guid: e29e2a4a249eb4842b23edfdfeefa1c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Atmo Mountain + Crosswind Lake
  shortName: Atmo Mountain + Crosswind Lake
  category: Sample site
  when: "Sols 634 & 639  \xB7  Dec 2 & 7, 2022"
  activity: Scooped two regolith samples (loose soil and pebbles), Atmo Mountain and Crosswind Lake, near Observation Mountain and sealed them in sample tubes. The material is likely mixed sedimentary and igneous grains.
  subtitle: "Regolith  \xB7  Likely mixed sedimentary and igneous grains"
  details: "Samples 17 & 18  \xB7  Observation Mountain outcrop, Fan Front\nSol 634 & 639  \xB7  Dec. 2&7, 2022  \xB7  sample length 6.7 cm"
  photos:
  - image: {fileID: 2800000, guid: 18d258643fbb128428a2d13397dc21a4, type: 3}
    caption: The robotic arm over the sand
    credit: "Front Hazcam  \xB7  Sol 634  \xB7  NASA/JPL-Caltech"
  - image: {fileID: 2800000, guid: bdf5fce9f7dc8994a9bbe831f851989a, type: 3}
    caption: The regolith (pebbles and sand) that was sampled
    credit: "WATSON  \xB7  Sol 633  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 27621baae18439849a87190f000d3ec3, type: 3}
    caption: Wheel scuff in the regolith
    credit: "Front Hazcam  \xB7  Sol 634  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.40121811
  latitude: 18.45131442
  revealRadius: 15
