  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Depot tube 10
  shortName: Tube 10
  category: Depot tube
  when: "Sol 687  \xB7  Jan 25, 2023"
  activity: Perseverance set sample tube 10 of 10 down here while building the Three Forks depot, a backup set of samples for a future Mars Sample Return mission.
  subtitle: Sample tube left at the Three Forks depot
  details: "Dropped on sol 687 (10 of 10)  \xB7  photographed sol 690 (2023-01-28)\nPosition: where the rover parked to drop it (about 1-2 m)"
  photos:
  - image: {fileID: 2800000, guid: 113c1be5456fc9646a20df38593a4867, type: 3}
    caption: The tube on the ground under the rover, just after the drop
    credit: "WATSON  \xB7  Sol 690  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 4a052c4c38ddf3d45a1fda19e9593306, type: 3}
    caption: The tube on the ground after the rover backed away
    credit: "Front Hazcam  \xB7  Sol 693  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.408447
  latitude: 18.453372
  revealRadius: 4
