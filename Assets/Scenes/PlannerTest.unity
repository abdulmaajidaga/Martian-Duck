  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Depot tube 3
  shortName: Tube 3
  category: Depot tube
  when: "Sol 661  \xB7  Dec 30, 2022"
  activity: Perseverance set sample tube 3 of 10 down here while building the Three Forks depot, a backup set of samples for a future Mars Sample Return mission.
  subtitle: Sample tube left at the Three Forks depot
  details: "Dropped on sol 661 (3 of 10)  \xB7  photographed sol 661 (2022-12-29)\nPosition: where the rover parked to drop it (about 1-2 m)"
  photos:
  - image: {fileID: 2800000, guid: 3f826f7e62d9fac4e8b9525c7a77ec32, type: 3}
    caption: The tube on the ground under the rover, just after the drop
    credit: "WATSON  \xB7  Sol 661  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 03b7bd613351efa40b42294dc8df7b3d, type: 3}
    caption: The tube on the ground after the rover backed away
    credit: "Front Hazcam  \xB7  Sol 663  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.408056
  latitude: 18.45267
  revealRadius: 4
