  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Depot tube 7
  shortName: Tube 7
  category: Depot tube
  when: "Sol 675  \xB7  Jan 13, 2023"
  activity: Perseverance set sample tube 7 of 10 down here while building the Three Forks depot, a backup set of samples for a future Mars Sample Return mission.
  subtitle: Sample tube left at the Three Forks depot
  details: "Dropped on sol 675 (7 of 10)  \xB7  photographed sol 675 (2023-01-13)\nPosition: where the rover parked to drop it (about 1-2 m)"
  photos:
  - image: {fileID: 2800000, guid: 444c8342e7f770c49a7f134749c86164, type: 3}
    caption: The tube on the ground under the rover, just after the drop
    credit: "WATSON  \xB7  Sol 675  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: c9a496bdea8f68f41963d04489dd46c6, type: 3}
    caption: The tube on the ground after the rover backed away
    credit: "Front Hazcam  \xB7  Sol 678  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.408336
  latitude: 18.452728
  revealRadius: 4
