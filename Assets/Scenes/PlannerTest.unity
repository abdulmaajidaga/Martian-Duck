  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Depot tube 6
  shortName: Tube 6
  subtitle: Sample tube left at the Three Forks depot
  details: "Dropped on sol 672 (6 of 10)  \xB7  photographed sol 672 (2023-01-10)\nPosition: where the rover parked to drop it (about 1-2 m)"
  photos:
  - image: {fileID: 2800000, guid: 74bc8e536c43122419823857aa98f070, type: 3}
    caption: 'WATSON: the tube on the ground under the rover, just after the drop'
    credit: "Sol 672  \xB7  WATSON  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: 70a0e7291f2e2df428d1f71bb6b173b7, type: 3}
    caption: 'Front Hazcam: the tube on the ground after the rover backed away'
    credit: "Sol 674  \xB7  Front Hazcam (left)  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.408244
  latitude: 18.452813
  revealRadius: 4
