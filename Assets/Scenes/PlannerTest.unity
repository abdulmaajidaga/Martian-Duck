  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PointOfInterest
  displayName: Depot tube 5
  shortName: Tube 5
  subtitle: Sample tube left at the Three Forks depot
  details: "Dropped on sol 668 (5 of 10)  \xB7  photographed sol 668 (2023-01-06)\nPosition: where the rover parked to drop it (about 1-2 m)"
  photos:
  - image: {fileID: 2800000, guid: aef15646a6e38bb49b68d84fffdad6ef, type: 3}
    caption: 'WATSON: the tube on the ground under the rover, just after the drop'
    credit: "Sol 668  \xB7  WATSON  \xB7  NASA/JPL-Caltech/MSSS"
  - image: {fileID: 2800000, guid: f523ddaa153bbbc4cb123bd61ad1f92f, type: 3}
    caption: 'Front Hazcam: this tube came to rest standing on its end'
    credit: "Sol 670  \xB7  Front Hazcam (left)  \xB7  NASA/JPL-Caltech"
  placeByLonLat: 1
  longitude: 77.4082
  latitude: 18.452724
  revealRadius: 4
