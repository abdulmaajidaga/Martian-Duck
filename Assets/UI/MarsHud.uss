/* Astronaut visor HUD: thin cyan lines, translucent dark panels, white/cyan text with a soft shadow so it stays
   readable over the orange terrain. Panels sit at the screen edges; the centre stays clear. */

.hud-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---------- regions ---------- */
.hud-region { position: absolute; }
.region-topcenter { top: 12px; left: 0; right: 0; align-items: center; }
.region-topleft { top: 14px; left: 18px; }
.region-topright { top: 14px; right: 18px; align-items: flex-end; }
.region-bottomleft { bottom: 18px; left: 18px; }
.region-bottomright { bottom: 18px; right: 18px; align-items: flex-end; }
.region-leftmiddle { left: 18px; top: 38%; }
.region-fullscreen { left: 0; top: 0; right: 0; bottom: 0; }
.region-rightmiddle { right: 18px; top: 26%; align-items: flex-end; }
.hud-fullscreen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---------- panels and text ---------- */
.hud-panel {
    background-color: rgba(3, 16, 24, 0.40);
    border-width: 1px;
    border-color: rgba(110, 235, 255, 0.55);
    border-radius: 2px;
    padding: 6px 10px 6px 10px;
    margin-bottom: 8px;
    min-width: 200px;
}
.hud-row { flex-direction: row; align-items: center; }

.hud-title, .hud-label, .hud-value, .hud-small, .hud-placeholder, .help-key, .hud-hint,
.compass-label, .compass-heading, .map-north-label, .map-waypoint-label {
    margin: 0; padding: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85);
}
.hud-title { font-size: 11px; color: rgba(130, 240, 255, 0.95); letter-spacing: 2px; -unity-font-style: bold; margin-bottom: 3px; }
.hud-label { font-size: 12px; color: rgba(150, 235, 250, 0.90); min-width: 52px; }
.hud-value { font-size: 18px; color: rgb(238, 252, 255); }
.hud-small { font-size: 10px; color: rgba(150, 230, 245, 0.80); margin-top: 2px; }
.hud-placeholder { font-size: 9px; color: rgb(255, 205, 90); letter-spacing: 1px; margin-bottom: 2px; }
.hud-warning { color: rgb(255, 120, 90); }

.hud-bar { height: 4px; background-color: rgba(110, 235, 255, 0.18); border-width: 1px; border-color: rgba(110, 235, 255, 0.45); margin: 2px 0 4px 0; }
.hud-bar-fill { height: 100%; background-color: rgba(120, 240, 255, 0.85); }
.hud-bar-warning { background-color: rgba(255, 120, 90, 0.9); }

.hud-hint { position: absolute; bottom: 8px; left: 0; right: 0; -unity-text-align: middle-center; font-size: 10px; color: rgba(150, 230, 245, 0.55); letter-spacing: 2px; }

/* ---------- compass ---------- */
.compass-panel { align-items: center; min-width: 0; padding: 4px 0 4px 0; background-color: rgba(3, 16, 24, 0.30); }
.compass-strip { height: 40px; overflow: hidden; }
.compass-tick { position: absolute; top: 0; width: 1px; height: 6px; background-color: rgba(150, 240, 255, 0.55); }
.compass-tick-major { height: 11px; background-color: rgba(190, 248, 255, 0.85); }
.compass-tick-cardinal { height: 15px; width: 2px; background-color: rgb(240, 253, 255); }
.compass-label { position: absolute; top: 16px; width: 40px; -unity-text-align: upper-center; font-size: 11px; color: rgba(160, 240, 255, 0.85); }
.compass-cardinal { font-size: 16px; color: rgb(245, 254, 255); -unity-font-style: bold; top: 15px; }
.compass-intercardinal { font-size: 12px; color: rgb(205, 248, 255); }
.compass-caret { position: absolute; top: 0; left: 50%; width: 10px; height: 8px; margin-left: -5px; }
.compass-heading { font-size: 15px; color: rgb(240, 253, 255); -unity-font-style: bold; letter-spacing: 1px; }

/* ---------- waypoint ---------- */
.waypoint-panel { min-width: 230px; }
.waypoint-arrow { width: 30px; height: 34px; margin-right: 10px; }
.waypoint-text { flex-grow: 1; }

/* ---------- point of interest: card + photo viewer ----------
   Warm, quiet palette (dark umber glass, one orange accent), photo first, readable sentence-case text. */
.poi-card {
    background-color: rgba(18, 14, 12, 0.96);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 8px;
}
.poi-card-photo { background-color: rgb(30, 24, 20); }
.poi-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.poi-card-body { padding: 14px 18px 14px 18px; }
.poi-row { flex-direction: row; align-items: center; }

.poi-eyebrow { color: rgb(240, 150, 80); font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; flex-grow: 1; margin: 0; padding: 0; }
.poi-distance { color: rgba(235, 220, 205, 0.55); font-size: 12px; margin: 0; padding: 0; }
.poi-title { color: rgb(250, 244, 236); font-size: 24px; -unity-font-style: bold; margin: 4px 0 2px 0; padding: 0; white-space: normal; }
.poi-when { color: rgba(235, 220, 205, 0.70); font-size: 14px; margin: 0 0 10px 0; padding: 0; }
.poi-activity { color: rgba(250, 244, 236, 0.92); font-size: 15px; white-space: normal; margin: 0 0 10px 0; padding: 0; }
.poi-caption { color: rgba(235, 220, 205, 0.60); font-size: 13px; -unity-font-style: italic; white-space: normal; margin: 0 0 12px 0; padding: 0; }
.poi-credit { color: rgba(235, 220, 205, 0.45); font-size: 12px; margin: 2px 0 0 0; padding: 0; }

.poi-hint-row { margin-top: 2px; }
.poi-key {
    color: rgb(250, 244, 236); font-size: 12px; -unity-font-style: bold;
    border-width: 1px; border-color: rgba(250, 244, 236, 0.35); border-radius: 4px;
    padding: 1px 6px 1px 6px; margin: 0 6px 0 0;
}
.poi-key-gap { margin-left: 14px; }
.poi-hint { color: rgba(235, 220, 205, 0.65); font-size: 13px; margin: 0; padding: 0; }

/* round arrow buttons */
.poi-arrow {
    position: absolute; width: 36px; height: 36px; top: 50%; margin: -18px 0 0 0; padding: 0;
    border-width: 0; border-radius: 18px; background-color: rgba(10, 8, 7, 0.55);
    align-items: center; justify-content: center;
}
.poi-arrow:hover { background-color: rgba(240, 150, 80, 0.85); }
.poi-arrow:active { background-color: rgb(240, 150, 80); }
.poi-arrow-left { left: 10px; }
.poi-arrow-right { right: 10px; }
.poi-icon { width: 16px; height: 16px; color: rgb(250, 244, 236); }

/* photo position dots */
.poi-dots { position: absolute; bottom: 10px; left: 0; right: 0; flex-direction: row; justify-content: center; }
.poi-dots-static { position: relative; bottom: 0; justify-content: flex-start; margin: 10px 0 8px 0; }
.poi-dot { width: 7px; height: 7px; border-radius: 4px; margin: 0 3px 0 3px; background-color: rgba(250, 244, 236, 0.40); }
.poi-dot-on { background-color: rgb(250, 244, 236); }

/* full-screen viewer */
.poi-viewer {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(10, 8, 7, 0.95);
    align-items: center; justify-content: center;
}
.poi-viewer-stage { flex-direction: row; align-items: center; width: 82%; height: 66%; }
.poi-viewer-frame { flex-grow: 1; height: 100%; margin: 0 20px 0 20px; }
.poi-arrow-big { position: relative; top: 0; margin: 0; width: 56px; height: 56px; border-radius: 28px; flex-shrink: 0; }
.poi-arrow-big .poi-icon { width: 24px; height: 24px; }
.poi-viewer-info { width: 62%; margin-top: 22px; }
.poi-viewer-title { color: rgb(250, 244, 236); font-size: 28px; -unity-font-style: bold; flex-grow: 1; margin: 0; padding: 0; }
.poi-viewer-counter { color: rgba(235, 220, 205, 0.60); font-size: 16px; margin: 0; padding: 0; }
.poi-viewer-caption { color: rgba(250, 244, 236, 0.92); font-size: 17px; white-space: normal; margin: 0; padding: 0; }
.poi-close {
    position: absolute; top: 28px; right: 32px; width: 44px; height: 44px; padding: 0; border-width: 0;
    border-radius: 22px; background-color: rgba(250, 244, 236, 0.10); align-items: center; justify-content: center;
}
.poi-close:hover { background-color: rgba(240, 150, 80, 0.85); }
.poi-close .poi-icon { width: 18px; height: 18px; }

/* ---------- layer panel ---------- */
.layer-panel { position: absolute; left: 18px; top: 34%; min-width: 250px; }
.layer-row { margin: 2px 0 4px 0; }
.layer-toggle { margin: 0; }
.layer-toggle Label { color: rgb(235, 252, 255); font-size: 13px; min-width: 0; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85); }
.layer-toggle .unity-toggle__checkmark { border-color: rgba(110, 235, 255, 0.8); background-color: rgba(3, 16, 24, 0.6); -unity-background-image-tint-color: rgb(140, 245, 255); }
.layer-legend { margin-left: 22px; }
.layer-desc { display: none; }

/* ---------- help ---------- */
.help-panel { position: absolute; top: 30%; left: 50%; width: 360px; margin-left: -180px; background-color: rgba(3, 16, 24, 0.72); padding: 10px 14px 10px 14px; }
.help-key { font-size: 13px; color: rgb(140, 245, 255); -unity-font-style: bold; width: 90px; }

/* ---------- map ----------
   Same warm glass look as the point-of-interest card: dark umber, one orange accent, large sentence-case text.
   The first-person view shows through a translucent backdrop around the terrain. */
.map-card {
    background-color: rgba(18, 14, 12, 0.84);
    border-radius: 10px;
    padding: 16px 20px 16px 20px;
    margin-bottom: 12px;
}
.map-column { position: absolute; flex-direction: column; }
.map-column-left { top: 20px; left: 20px; width: 360px; }

.map-scrim { position: absolute; }
.map-frame { position: absolute; border-width: 1px; border-color: rgba(240, 150, 80, 0.55); }

/* controls */
.map-keys { margin-top: 10px; }
.map-key-row { margin: 3px 0 3px 0; }
.map-key { font-size: 14px; min-width: 62px; -unity-text-align: middle-center; padding: 3px 8px 3px 8px; margin-right: 12px; }
.map-key-hint { color: rgba(250, 244, 236, 0.85); font-size: 15px; margin: 0; padding: 0; }

/* selected point + stops */
.map-focus { margin-bottom: 6px; }
.map-focus-activity { font-size: 14px; max-height: 64px; overflow: hidden; }
.map-btn {
    margin: 4px 0 0 0; padding: 8px 14px 8px 14px; border-width: 0; border-radius: 6px;
    font-size: 15px; -unity-font-style: bold; color: rgb(250, 244, 236);
}
.map-btn-primary { background-color: rgb(214, 120, 56); }
.map-btn-primary:hover { background-color: rgb(240, 150, 80); }
.map-btn-quiet { background-color: rgba(250, 244, 236, 0.08); font-size: 13px; padding: 4px 10px 4px 10px; margin: 0; }
.map-btn-quiet:hover { background-color: rgba(240, 150, 80, 0.85); }
.map-stops-head { margin-top: 10px; padding-top: 12px; border-top-width: 1px; border-color: rgba(250, 244, 236, 0.12); }
.map-stop-list { margin-top: 6px; }
.map-stop-row { flex-direction: row; align-items: center; padding: 6px 8px 6px 8px; margin: 2px 0 2px 0; border-radius: 6px; }
.map-stop-row:hover { background-color: rgba(250, 244, 236, 0.07); }
.map-stop-row-focused { background-color: rgba(240, 150, 80, 0.18); }
.map-stop-num {
    width: 24px; height: 24px; border-radius: 12px; margin: 0 10px 0 0; padding: 0;
    background-color: rgb(214, 120, 56); color: rgb(250, 244, 236);
    font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.map-stop-name { flex-grow: 1; color: rgb(250, 244, 236); font-size: 15px; margin: 0; padding: 0; }
.map-stop-remove {
    width: 26px; height: 26px; padding: 0; margin: 0; border-width: 0; border-radius: 13px;
    background-color: rgba(250, 244, 236, 0.06); align-items: center; justify-content: center;
}
.map-stop-remove:hover { background-color: rgba(240, 150, 80, 0.85); }
.map-stop-remove .poi-icon { width: 12px; height: 12px; }

/* north arrow */
.map-north {
    position: absolute; top: 20px; right: 20px; width: 64px; height: 64px; border-radius: 32px;
    background-color: rgba(18, 14, 12, 0.84); align-items: center; justify-content: center;
}
.map-north-arrow { width: 18px; height: 24px; }
.map-north-label { font-size: 14px; color: rgb(250, 244, 236); -unity-font-style: bold; margin: 0; padding: 0; }

/* scale + position */
.map-info { position: absolute; bottom: 20px; right: 20px; width: 340px; margin: 0; }
.map-info-gap { margin-top: 14px; }
.map-scale-row { margin-top: 8px; align-items: flex-end; }
.map-scalebar {
    height: 12px; border-left-width: 3px; border-right-width: 3px; border-bottom-width: 3px;
    border-color: rgb(250, 244, 236); margin-right: 14px;
}
.map-scale-label { color: rgb(250, 244, 236); font-size: 20px; -unity-font-style: bold; margin: 0; padding: 0; }
.map-readout { margin-top: 4px; }
.map-readout-label { color: rgba(235, 220, 205, 0.60); font-size: 14px; width: 100px; margin: 0; padding: 0; }
.map-readout-value { color: rgb(250, 244, 236); font-size: 17px; margin: 0; padding: 0; }

/* markers */
.map-player { position: absolute; width: 26px; height: 30px; }
.map-waypoint { position: absolute; flex-direction: row; align-items: center; }
.map-waypoint-dot { width: 16px; height: 16px; border-radius: 8px; border-width: 2px; border-color: rgb(255, 230, 90); background-color: rgba(255, 210, 60, 0.35); }
.map-waypoint-label { font-size: 14px; color: rgb(255, 236, 140); margin-left: 6px; }
.map-waypoint-next .map-waypoint-dot { background-color: rgba(255, 220, 60, 0.9); }
.map-waypoint-done .map-waypoint-dot { border-color: rgba(200, 200, 200, 0.7); background-color: rgba(120, 120, 120, 0.4); }
.map-waypoint-done .map-waypoint-label { color: rgba(220, 220, 220, 0.7); }

.map-poi {
    position: absolute; flex-direction: row; align-items: center; height: 28px;
    padding: 0 10px 0 7px; border-radius: 14px; transition-duration: 0.12s;
}
.map-poi-dot {
    width: 14px; height: 14px; rotate: 45deg; border-width: 2px;
    border-color: rgb(255, 170, 100); background-color: rgba(255, 140, 70, 0.55);
}
.map-poi-label {
    font-size: 14px; color: rgb(255, 214, 175); margin: 0 0 0 9px; padding: 0;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95);
}
.map-poi:hover { background-color: rgba(18, 14, 12, 0.80); }
.map-poi:hover .map-poi-label { color: rgb(250, 244, 236); }
.map-poi-selected { background-color: rgba(18, 14, 12, 0.72); }
.map-poi-selected .map-poi-dot { background-color: rgb(240, 150, 80); border-color: rgb(250, 244, 236); }
.map-poi-selected .map-poi-label { color: rgb(250, 244, 236); -unity-font-style: bold; }
.map-poi-focused { background-color: rgba(214, 120, 56, 0.90); }
.map-poi-focused .map-poi-label { color: rgb(255, 255, 255); }

/* layer panel in map mode: big, on the right, same card look */
.map-mode .layer-panel {
    left: auto; top: 100px; right: 20px; width: 340px; min-width: 0;
    background-color: rgba(18, 14, 12, 0.84); border-width: 0; border-radius: 10px;
    padding: 16px 20px 14px 20px;
}
.map-mode .layer-title { color: rgb(240, 150, 80); font-size: 12px; letter-spacing: 1px; text-shadow: none; margin-bottom: 8px; }
.map-mode .layer-row {
    margin: 0 0 6px 0; padding: 10px 12px 10px 12px; border-radius: 8px;
    background-color: rgba(250, 244, 236, 0.05);
}
.map-mode .layer-row:hover { background-color: rgba(250, 244, 236, 0.10); }
.map-mode .layer-toggle Label { font-size: 16px; color: rgb(250, 244, 236); text-shadow: none; }
.map-mode .layer-toggle .unity-toggle__checkmark {
    width: 20px; height: 20px; margin-right: 10px; border-radius: 4px;
    border-color: rgba(250, 244, 236, 0.45); background-color: rgba(250, 244, 236, 0.06);
    -unity-background-image-tint-color: rgb(240, 150, 80);
}
.map-mode .layer-toggle:checked .unity-toggle__checkmark { border-color: rgb(240, 150, 80); }
.map-mode .layer-desc { display: flex; color: rgba(235, 220, 205, 0.70); font-size: 13px; white-space: normal; margin: 4px 0 0 30px; padding: 0; }
.map-mode .layer-legend { color: rgba(235, 220, 205, 0.60); font-size: 13px; margin: 4px 0 0 30px; text-shadow: none; }
.map-mode .layer-foot { color: rgba(235, 220, 205, 0.50); font-size: 13px; text-shadow: none; margin-top: 4px; }
