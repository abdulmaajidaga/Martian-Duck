# ---------------------------------------------------------------------------
# Unity: everything Unity regenerates on open
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store tools / crash reports / profiler captures
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.apk
*.aab
*.unitypackage
*.app

# IDE / generated project files (Unity regenerates these)
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# Mars data: large public source files (download them, see MarsSources/README.md)
# The GeoJSON route files in MarsSources ARE committed.
# ---------------------------------------------------------------------------
/MarsSources/*.IMG
/MarsSources/*.img
/MarsSources/*.JP2
/MarsSources/*.jp2
/MarsSources/*.tif
/MarsSources/*.tiff
/MarsSources/*.png

# Large rasters dropped in the project root (e.g. Mars Trek downloads): never commit
/*.tif
/*.tiff
/*.TIF
/*.img
/*.IMG
/*.jp2
/*.JP2
/*.tif.aux.xml

# Preview / debug images: keep only the HUD screenshots
/MarsPreviews/*
!/MarsPreviews/hud_*.png

# ---------------------------------------------------------------------------
# Python tools
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------------------
# Machine-specific / OS junk
# ---------------------------------------------------------------------------
# Claude Code MCP config contains an absolute path to this machine's Unity
.mcp.json
.claude/
*.crdownload
*.part
.DS_Store
Thumbs.db
desktop.ini
